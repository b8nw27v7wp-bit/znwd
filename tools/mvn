#!/usr/bin/env bash
# 本地 Maven 启动器（给 git-bash/MSYS 用）
#
# 为什么需要：官方 bin/mvn 是 shell 脚本，它在 MSYS 下走的是 mingw 分支，
# 不会把 /d/Maven/... 转成 Windows 路径，java 收到这种路径无法加载
# plexus-classworlds，于是报 "找不到主类 ... Launcher"。
# 这里直接以 Windows 风格路径调用 Maven 自己的 launcher，绕开该问题。
#
# 用法：tools/mvn clean package      （等价于 mvn clean package）
# Maven/JDK 换位置时改下面两行，或用环境变量覆盖。
set -euo pipefail

MVN_HOME_WIN="${MVN_HOME_WIN:-D:/Maven/apache-maven-3.9.16}"
JAVA_HOME_WIN="${JAVA_HOME_WIN:-D:/JDK25}"

CLASSWORLDS="$(ls "$MVN_HOME_WIN"/boot/plexus-classworlds-*.jar 2>/dev/null | head -1)"
if [ -z "$CLASSWORLDS" ]; then
  echo "找不到 plexus-classworlds，请检查 MVN_HOME_WIN=$MVN_HOME_WIN" >&2
  exit 1
fi

PROJECT_DIR="$(cygpath -w "$PWD" 2>/dev/null || echo "$PWD")"

exec "$JAVA_HOME_WIN/bin/java" \
  --add-opens java.base/java.lang=ALL-UNNAMED \
  --enable-native-access=ALL-UNNAMED \
  -classpath "$CLASSWORLDS" \
  -Dclassworlds.conf="$MVN_HOME_WIN/bin/m2.conf" \
  -Dmaven.home="$MVN_HOME_WIN" \
  -Dmaven.multiModuleProjectDirectory="$PROJECT_DIR" \
  org.codehaus.plexus.classworlds.launcher.Launcher "$@"
