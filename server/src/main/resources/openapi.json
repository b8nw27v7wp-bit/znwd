{
  "openapi": "3.0.0",
  "info": { "title": "Virtual Hostess API", "version": "1.3.0" },
  "servers": [{ "url": "/" }],
  "components": {
    "schemas": {
      "Source": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "snippet": { "type": "string", "description": "分块前 200 字的列表摘要" },
          "score": { "type": "number" },
          "sourcePath": { "type": "string" },
          "zone": { "type": "string", "nullable": true },
          "zoneTitle": { "type": "string", "nullable": true },
          "vectorScore": { "type": "number", "nullable": true },
          "keywordScore": { "type": "number", "nullable": true },
          "chunkText": { "type": "string", "description": "命中分块的完整原文（超长截断到 800 字）" },
          "matchTerm": { "type": "string", "nullable": true, "description": "本次命中的关键词，在 chunkText 中原样出现（定位不到时缺省）" },
          "matchOffset": { "type": "integer", "description": "matchTerm 在 chunkText 中的字符偏移；-1 = 未定位到" }
        },
        "required": ["title", "snippet", "score", "sourcePath"]
      },
      "ChatRequest": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "sessionId": { "type": "string", "maxLength": 64 }
        }
      },
      "ChatResponse": {
        "type": "object",
        "properties": {
          "answer": { "type": "string" },
          "sources": { "type": "array", "items": { "$ref": "#/components/schemas/Source" } },
          "mode": { "type": "string", "enum": ["rag", "llm_only"] },
          "provider": { "type": "string" },
          "retrieval": { "type": "string", "enum": ["hybrid", "keyword"] },
          "noHit": { "type": "boolean", "description": "相关性闸门未通过（知识库未覆盖）" },
          "sessionId": { "type": "string", "nullable": true },
          "sessionToken": { "type": "string", "description": "会话访问令牌：GET/DELETE /api/sessions/{id} 需带（X-Session-Token 头或 ?sessionToken= 查询串），不匹配回 404" },
          "latencyMs": { "type": "number" },
          "cached": { "type": "boolean" },
          "usage": {
            "type": "object",
            "nullable": true,
            "properties": {
              "promptTokens": { "type": "integer" },
              "completionTokens": { "type": "integer" },
              "reasoningTokens": { "type": "integer" },
              "totalTokens": { "type": "integer" }
            }
          },
          "rewrite": {
            "type": "object",
            "nullable": true,
            "properties": {
              "rewritten": { "type": "boolean" },
              "reason": { "type": "string", "enum": ["none", "no_history", "prev_weak", "ellipsis_merged"] },
              "carriedTokens": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "required": ["answer", "sources", "mode", "provider", "retrieval", "noHit"]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string" },
          "message": { "type": "string" },
          "requestId": { "type": "string", "nullable": true }
        },
        "required": ["error", "message"]
      },
      "Diagnostics": {
        "type": "object",
        "description": "检索诊断：这句话为什么被拦/为什么命中（走线上同一套阈值与索引）",
        "properties": {
          "query": { "type": "string" },
          "topK": { "type": "integer" },
          "gated": { "type": "boolean", "description": "true = 被相关性闸门拦下（知识库未覆盖）" },
          "mode": { "type": "string", "enum": ["keyword", "hybrid"] },
          "reason": { "type": "string", "enum": ["keyword_hit", "vector_hit", "no_candidates", "below_threshold"] },
          "semantic": { "type": "boolean", "description": "向量路是否可用（false = 降级为关键词路）" },
          "degraded": { "type": "boolean" },
          "keywordBestScore": { "type": "number" },
          "keywordGateScore": { "type": "number" },
          "vectorBestCosine": { "type": "number" },
          "candidates": { "type": "integer" },
          "thresholds": {
            "type": "object",
            "properties": {
              "minKeywordScore": { "type": "number" },
              "minVectorScore": { "type": "number" }
            }
          },
          "distanceToGate": { "type": "number", "description": ">0 表示还差多少才够阈值" },
          "verdict": { "type": "string", "description": "人话结论" },
          "hits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "sourcePath": { "type": "string" },
                "zone": { "type": "string", "nullable": true },
                "zoneTitle": { "type": "string", "nullable": true },
                "fuseScore": { "type": "number" },
                "keywordScore": { "type": "number" },
                "vectorScore": { "type": "number" },
                "matchedTokens": { "type": "integer" },
                "matched": { "type": "array", "items": { "type": "string" } },
                "snippet": { "type": "string" }
              }
            }
          }
        },
        "required": ["query", "hits", "gated", "verdict"]
      },
      "Synonyms": {
        "type": "object",
        "properties": {
          "count": { "type": "integer" },
          "source": { "type": "string", "description": "builtin 或生效中的文件路径" },
          "file": { "type": "string", "description": "覆盖表落盘位置" },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": { "type": "string" },
                "alternatives": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "tsv": { "type": "string" }
        },
        "required": ["count", "source"]
      },
      "SpeechRequest": {
        "type": "object",
        "properties": {
          "text": { "type": "string", "description": "单句文本（前端按句切片后再请求）" }
        },
        "required": ["text"]
      },
      "RecognizeRequest": {
        "type": "object",
        "properties": {
          "audio": { "type": "string", "description": "data:audio/wav;base64,… 或裸 base64（只收 WAV/16bit PCM）" }
        },
        "required": ["audio"]
      },
      "Recognition": {
        "type": "object",
        "properties": {
          "text": { "type": "string" },
          "seconds": { "type": "number", "description": "音频时长，用来区分「说了话」与「录到一片静音」" },
          "elapsedMs": { "type": "integer" }
        },
        "required": ["text"]
      }
    },
    "parameters": {
      "SessionToken": {
        "name": "X-Session-Token",
        "in": "header",
        "required": false,
        "schema": { "type": "string" },
        "description": "会话访问令牌：/api/chat（与 SSE 的 done 帧）响应里的 sessionToken 字段；带 Header 的场景之外也接受查询参数 ?sessionToken=。下发过令牌的会话必须携带且匹配，否则按不存在回 404；从未下发过令牌的老会话可不带。"
      }
    },
    "securitySchemes": {
      "adminToken": { "type": "http", "scheme": "bearer" }
    }
  },
  "paths": {
    "/api/health": { "get": { "summary": "运行状态", "responses": { "200": { "description": "健康信息（含检索模式、embeddingReady、阈值、CORS 白名单）" } } } },
    "/api/health/summary": { "get": { "summary": "运行摘要", "responses": { "200": { "description": "问答统计摘要" } } } },
    "/api/chat": {
      "post": {
        "summary": "问答（非流式）",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChatRequest" } } } },
        "responses": {
          "200": { "description": "回答", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChatResponse" } } } },
          "400": { "description": "入参非法", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "429": { "description": "超出限流 CHAT_RATE_PER_MIN" }
        }
      }
    },
    "/api/chat/stream": {
      "post": {
        "summary": "问答（SSE：meta → delta* → done）",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChatRequest" } } } },
        "responses": { "200": { "description": "text/event-stream：meta → delta* → done（done 帧带 sessionToken）" } }
      }
    },
    "/api/suggestions": {
      "get": {
        "summary": "推荐问题",
        "parameters": [{ "name": "zone", "in": "query", "schema": { "type": "string" }, "description": "zoneId 或 mediaId" }],
        "responses": { "200": { "description": "推荐问法列表" } }
      }
    },
    "/api/zones": { "get": { "summary": "展区分区与媒体映射", "responses": { "200": { "description": "zones" } } } },
    "/api/knowledge/list": {
      "get": {
        "summary": "知识文件清单",
        "security": [{ "adminToken": [] }],
        "responses": { "200": { "description": "docs + retrieval stats" }, "401": { "description": "unauthorized" } }
      }
    },
    "/api/knowledge/reload": {
      "post": {
        "summary": "重载知识并重建向量索引",
        "security": [{ "adminToken": [] }],
        "responses": { "200": { "description": "reload 结果" }, "401": { "description": "unauthorized" } }
      }
    },
    "/api/admin/feedback-stats": {
      "get": {
        "summary": "反馈统计（?format=csv 导出）",
        "security": [{ "adminToken": [] }],
        "parameters": [{ "name": "format", "in": "query", "schema": { "type": "string", "enum": ["json", "csv"] } }],
        "responses": { "200": { "description": "统计或 CSV" }, "401": { "description": "unauthorized" } }
      }
    },
    "/api/admin/diagnostics": {
      "get": {
        "summary": "检索诊断：为什么被拦/为什么命中（?q=…&topK=4）",
        "security": [{ "adminToken": [] }],
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" }, "description": "要诊断的问题" },
          { "name": "topK", "in": "query", "schema": { "type": "integer", "default": 4, "maximum": 20 } }
        ],
        "responses": {
          "200": { "description": "诊断结果", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Diagnostics" } } } },
          "400": { "description": "q 缺失" },
          "401": { "description": "unauthorized" }
        }
      }
    },
    "/api/admin/synonyms": {
      "get": {
        "summary": "当前生效的同义词表",
        "security": [{ "adminToken": [] }],
        "responses": { "200": { "description": "同义词表", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Synonyms" } } } }, "401": { "description": "unauthorized" } }
      },
      "put": {
        "summary": "替换同义词表（立即生效，可选落盘）",
        "description": "请求体收 { lines: [\"主词\\t备选1,备选2\"] } 或 { entries: { \"主词\": [\"备选1\"] } }；persist=false 只改内存。同义词在查询时生效，无需重建索引。",
        "security": [{ "adminToken": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": {
          "200": { "description": "{ ok, count, source, persistedTo, reloadRequired:false }" },
          "400": { "description": "请求体为空或没有 lines/entries" },
          "401": { "description": "unauthorized" }
        }
      }
    },
    "/api/admin/uncovered": {
      "get": {
        "summary": "未覆盖问题清单（noHit 原始提问，供补资料）",
        "security": [{ "adminToken": [] }],
        "responses": { "200": { "description": "{ count, items[] }" }, "401": { "description": "unauthorized" } }
      }
    },
    "/api/stats": {
      "get": {
        "summary": "运行统计（MySQL 累计，重启不清零）",
        "security": [{ "adminToken": [] }],
        "responses": { "200": { "description": "统计" }, "401": { "description": "unauthorized" } }
      }
    },
    "/api/speech/synthesize": {
      "post": {
        "summary": "文本转语音（回 WAV 字节；未启用时 503 speech_unavailable）",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SpeechRequest" } } }
        },
        "responses": {
          "200": { "description": "audio/wav 字节（响应头 x-znwd-speech: live|cache）" },
          "400": { "description": "text 缺失/空白/超长", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "429": { "description": "超出限流 AUDIO_SYNTH_RATE_PER_MIN" },
          "502": { "description": "语音上游失败（前端降级到浏览器内置播报）" },
          "503": { "description": "语音未启用（AUDIO_PROVIDER=none）" }
        }
      }
    },
    "/api/speech/recognize": {
      "post": {
        "summary": "语音转文本（只收 WAV；未启用时 503）",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecognizeRequest" } } }
        },
        "responses": {
          "200": { "description": "识别结果", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Recognition" } } } },
          "400": { "description": "缺 audio／非 base64／非 WAV／超体积", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "413": { "description": "请求体超过 2MB 硬上限" },
          "429": { "description": "超出限流 CHAT_RATE_PER_MIN" },
          "502": { "description": "语音上游失败" },
          "503": { "description": "语音未启用（AUDIO_PROVIDER=none）" }
        }
      }
    },
    "/api/sessions/{sessionId}": {
      "get": {
        "summary": "查看会话",
        "parameters": [{ "$ref": "#/components/parameters/SessionToken" }],
        "responses": { "200": { "description": "messages" }, "404": { "description": "无会话，或 sessionToken 不匹配（不回 403，避免暴露会话是否存在）" } }
      },
      "delete": {
        "summary": "重置会话",
        "parameters": [{ "$ref": "#/components/parameters/SessionToken" }],
        "responses": { "200": { "description": "ok（token 不匹配时回 404）" } }
      }
    },
    "/api/feedback": {
      "post": { "summary": "回答点赞/点踩", "responses": { "200": { "description": "{ ok: true }" }, "400": { "description": "rating 非法" }, "429": { "description": "超出限流 FEEDBACK_RATE_PER_MIN" } } }
    }
  }
}
