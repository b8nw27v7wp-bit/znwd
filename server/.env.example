# LLM: mock | openai_compat
# Phase B C2：生产/展厅接内网网关时改为 openai_compat，并填写下列三项
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 智谱 GLM 示例（OpenAI 兼容）：
#   LLM_PROVIDER=openai_compat
#   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   LLM_MODEL=glm-4-flash        # 免费档实测 1.3~1.5s 稳定
# 小米 MiMo 示例（OpenAI 兼容，文档 mimo.mi.com/docs/zh-CN/api/chat/openai-api）：
#   LLM_PROVIDER=openai_compat
#   LLM_BASE_URL=https://api.xiaomimimo.com/v1
#   LLM_MODEL=mimo-v2.5          # 可选 mimo-v2.5-pro（更贵）
#   LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}   # 必填：MiMo 的 thinking 默认 enabled，开着又慢又贵
#   LLM_MAX_TOKENS=800           # 成本闸门：输出 token 上限（对应 max_completion_tokens）
# 免费档常有 429/1305 过载：客户端默认重试 2 次（退避 1s/2s，尊重 retry-after）
# LLM_MAX_RETRIES=2
# LLM_RETRY_BASE_MS=1000
# 单次调用总预算（含重试）；非流式默认 90000，流式默认 180000
# LLM_TIMEOUT_MS=90000

# Embedding（Hybrid RAG 向量路）
# bag = 离线特征哈希兜底（语义能力 semantic=false，此时检索一律按 keyword 上报）；
# openai_compat = 内网 embeddings 接口（推荐 bge-small-zh，semantic=true）
# Phase B C1：EMBED_PROVIDER=openai_compat + BASE_URL/KEY/MODEL 后 reload 重建索引
EMBED_PROVIDER=bag
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
# EMBED_DIMS=
# EMBED_BAG_DIMS=512

KNOWLEDGE_DIR=./knowledge
INDEX_DIR=./server/indexes
DATA_DIR=./server/data
PORT=8787
# Phase A: 默认仅本机；跨机访问请显式改为 0.0.0.0 并限制防火墙，或经反代暴露
HOST=127.0.0.1
CHAT_RATE_PER_MIN=30
# 配置后 stats/reload 需 Authorization: Bearer ***
# 闸门未通过时是否仍调用大模型生成拒答（默认 false：固定回复，省一次调用）
# NO_HIT_LLM=true

# ADMIN_TOKEN=
# 生产/预发强制管理口令：NODE_ENV=production|prod|staging，或下方显式开启
# REQUIRE_ADMIN_TOKEN=true
# NODE_ENV=production
# CORS 白名单（逗号分隔，可含 *）。不配置时只放行 localhost/127.0.0.1；生产须显式配置
# CORS_ORIGINS=https://exhibit.your-host.example,http://10.0.0.12:8080
ANSWER_CACHE_SIZE=200
# 相关性闸门：关键词分低于该值（且语义向量路也不达标）时回答「资料中没有」，不拿无关片段硬答
# 改知识库/同义词后用 `npm run calibrate -w server` 重新标定
MIN_RELEVANCE_SCORE=3.8
# 仅语义向量（EMBED_PROVIDER=openai_compat）生效：余弦低于该值不兜底
MIN_VECTOR_SCORE=0.35
# 未覆盖问题留存条数（明文、内存态，仅记录 noHit 的提问，供运营补资料；0 = 关闭）
UNCOVERED_LOG_SIZE=50
# 状态持久化：true 时把会话/计数/反馈/未覆盖清单写入 DATA_DIR/state.json，重启恢复
# （展厅每天开关机都需要，否则反馈历史与问答计数清零）
PERSIST_STATE=false
# 定时落盘间隔（秒），退出时也会落盘
PERSIST_INTERVAL_SEC=60
# true 时监听 knowledge/ 热更新（experimental，Windows 上不稳定；生产请用手动 reload）
KNOWLEDGE_WATCH=false
# JSONL 日志：字节上限与消息脱敏 hash|preview
LOG_MAX_BYTES=5000000
LOG_MESSAGE_MODE=hash
