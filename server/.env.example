# 本文件是模板：复制成 server/.env 再按需改（.env 不入库）。
# 读取顺序：系统环境变量 > server/.env > application.yml 默认值（见 config/DotEnvPropertySource.java）。
# 注意：所有键名以 server/src/main/resources/application.yml 为准。
#
# 一体机正式部署提醒：本模板默认是安全演示档（LLM mock、embedding bag、语音 none）。
# 展厅真实使用时请按 docs/deployment.md 改为 LLM_PROVIDER=openai_compat，按需打开
# EMBED_PROVIDER=openai_compat / AUDIO_PROVIDER=mimo；MySQL 保持 DB_HOST=127.0.0.1，
# 只允许模型、embedding、可选 TTS/ASR 出网，不配置远程数据库。

# ── 大模型（回答生成）─────────────────────────────────────────────
# mock = 不联网的固定摘要（CI/离线演示）；openai_compat = 任何 OpenAI 兼容网关
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 小米 MiMo 示例（OpenAI 兼容，文档 mimo.mi.com/docs/zh-CN/api/chat/openai-api）：
#   LLM_PROVIDER=openai_compat
#   LLM_BASE_URL=https://api.xiaomimimo.com/v1
#   LLM_MODEL=mimo-v2.5          # 可选 mimo-v2.5-pro（更贵）
#   LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}   # 必填：MiMo 的 thinking 默认 enabled，开着又慢又贵
#   LLM_MAX_TOKENS=800           # 成本闸门：输出 token 上限（对应 max_completion_tokens；0 = 不限制）
# 任何 OpenAI 兼容网关都能接：填 BASE_URL/API_KEY/MODEL 即可，不必为本项目改代码。
# 免费档常有 429/1305 过载：客户端默认重试 2 次（退避 1s/2s，尊重 retry-after）
# LLM_MAX_RETRIES=2
# LLM_RETRY_BASE_MS=1000
# 单次调用总预算（含重试）；非流式默认 90000，流式默认 180000
# LLM_TIMEOUT_MS=90000
# LLM_STREAM_TIMEOUT_MS=180000

# ── Embedding（Hybrid RAG 的向量路）──────────────────────────────
# bag = 离线特征哈希兜底（semantic=false，此时检索一律按 keyword 上报，不冒充 hybrid）；
# openai_compat = 任何 OpenAI 兼容 /embeddings（云端或内网网关，semantic=true）
# 本项目现用云端（免费、无需在展板机器上再跑一个模型服务）：
#   EMBED_PROVIDER=openai_compat
#   EMBED_BASE_URL=https://api.siliconflow.cn/v1
#   EMBED_MODEL=BAAI/bge-m3      # 1024 维，中文强，定价页标「免费」；免费档有限流（约 1000 RPM / 5~8 万 TPM）
# 换 provider 后必须重建索引（POST /api/knowledge/reload 或重启），索引按 provider 分文件存放。
# 语义路走外网后：embedding 不通时服务不启动失败，而是退化为仅关键词并在 /api/health 上报
# （embeddingReady=false + retrieval.vector.degradedReason），关键词路本来就独立可用。
EMBED_PROVIDER=bag
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
# EMBED_DIMS=1024              # bge-m3 = 1024；0 = 由首次响应推断
# EMBED_BAG_DIMS=512
# EMBED_TIMEOUT_MS=60000
# EMBED_BATCH_SIZE=32          # 单请求条数上限：各家不同（阿里云百炼 10、硅基流动 32），超一条整个请求 400

# ── 语音（TTS 播报 + ASR 识音）──────────────────────────────────
# 默认关闭：不配就完全不碰外部语音接口，前端自动退回浏览器内置语音合成。
# 启用（小米 MiMo，与上面的对话同网关同 key，所以 BASE_URL/API_KEY 留空即可）：
#   AUDIO_PROVIDER=mimo
# 关闭：AUDIO_PROVIDER=none（前端当场降级，问答不受影响）。
AUDIO_PROVIDER=none
AUDIO_BASE_URL=
AUDIO_API_KEY=
# 预置音色：冰糖/茉莉/苏打/白桦/Mia/Chloe/Milo/Dean/mimo_default
# AUDIO_VOICE=冰糖
# 风格指令（走 user 消息，不会被念出来）
# AUDIO_STYLE=用中文，语气亲切自然，语速稍慢，像展厅讲解员。
# AUDIO_TTS_MODEL=mimo-v2.5-tts
# AUDIO_ASR_MODEL=mimo-v2.5-asr
# 识别语种：auto/zh/en。展厅以中文为主，zh 更稳
# AUDIO_ASR_LANGUAGE=zh
# AUDIO_TIMEOUT_MS=60000
# AUDIO_MAX_RETRIES=2
# AUDIO_RETRY_BASE_MS=1000
# 单次合成文本上限（前端按句切片，正常远小于它）
# AUDIO_MAX_CHARS=300
# 识别上传上限（解码后的 WAV 字节）：16kHz/单声道/16bit 约 32KB/s，2MB ≈ 60 秒。
# 注意反代侧也要放到至少这么大，否则录音会被 413 拦在门外。
# AUDIO_MAX_UPLOAD_BYTES=2097152
# 合成结果缓存条数与合成限流（识别与问答共用 CHAT_RATE_PER_MIN）
# AUDIO_TTS_CACHE_SIZE=64
# 单条缓存的字节上限：超了照常返回、只是不入缓存（长文合成能出几 MB，只按条数封顶挡不住堆被吃满）
# AUDIO_TTS_CACHE_MAX_BYTES=524288
# AUDIO_SYNTH_RATE_PER_MIN=60
# 现场两条硬约束：① 浏览器只在 HTTPS 或 localhost 下给麦克风，一体机用 http://内网IP 打开时
# 「语音提问」按钮不出现（自动播报不受影响）；② 一体机要能出外网访问 MiMo（api.xiaomimimo.com）。

# ── MySQL（会话/统计/反馈/未覆盖问题落库；不配也能讲解，只是重启丢数据）──
# 首次部署：先把 server/db/init.sql 里两处 CHANGE_ME_znwd 改成自定口令，用管理员账号执行一次；
# 建表由应用在库可达时幂等执行 schema.sql，不需要手工建表。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=znwd
DB_USER=znwd
DB_PASSWORD=
# 与 init.sql 里设置的口令保持一致
# DB_POOL_SIZE=8        # Hikari 连接池上限
# 远程 DB 必须启用 TLS；本机默认 DISABLED 便于无证书开发
# DB_SSL_MODE=VERIFY_IDENTITY
# DB_ALLOW_PUBLIC_KEY_RETRIEVAL=false

# ── HTTP 服务 ────────────────────────────────────────────────────
# 默认仅监听本机；展厅内网跨机访问请显式改 0.0.0.0 并限制防火墙，或经反向代理暴露
HOST=127.0.0.1
PORT=8787
# 管理口令：配置后 /api/stats、/api/knowledge/reload、/api/admin/* 需带 Authorization: Bearer <token>
# 至少 16 位随机串；长度不足或是常见示例值（如 root:123456）时启动会打 WARN（不阻止启动）。
# ADMIN_TOKEN=
# 默认未配 ADMIN_TOKEN 时管理接口就要求口令；仅开发环境确认可接受回环免口令后再显式关闭
# REQUIRE_ADMIN_TOKEN=false
# NODE_ENV=production
# CORS 白名单（逗号分隔，可含 *）。不配置时只放行 localhost/127.0.0.1；生产须显式配置
# CORS_ORIGINS=https://exhibit.your-host.example,http://10.0.0.12:8080
# 前端产物目录：整机部署时 jar 直接托管该目录（页面与 /api 同源，免静态服务器、免 CORS）；
# 目录不存在（或没有 index.html）时自动关闭，开发时照旧用 Vite dev。默认 ./web/dist。
# WEB_DIST_DIR=./web/dist

# 限流键是否取 X-Forwarded-For（默认 false）。那个头客户端可写：打开前必须确认
# 前面挂着自家反代且反代会剥离同名头，否则限流可被「每次换一个头」绕过。
# TRUST_FORWARDED_FOR=false

# ── 检索与知识库 ─────────────────────────────────────────────────
KNOWLEDGE_DIR=./knowledge
INDEX_DIR=./server/indexes
DATA_DIR=./server/data
# 相关性闸门：关键词分低于该值（且语义向量路也不达标）时回答「资料中没有」，不拿无关片段硬答。
# 当前 6.3 是在 219 块语料（三份申报/概述/大赛材料）上按真实问句口径标定的：按闸门实际使用的
# 排序分口径，区间成立（域外最高 6.170 < 6.3 < 在域最低 6.438），闸门误拦 0 条、域外零漏放。
# 取舍依据见 docs/eval.md 的阈值取舍表；改语料或改同义词后必须重新标定。
# 改语料或改同义词后必须重新标定：cd server && ../tools/mvn -B test-compile exec:java@calibrate
# 改完要同步四处：这里、application.yml 的默认值、HybridRetriever.DEFAULT_MIN_KEYWORD_SCORE、CI workflow。
MIN_RELEVANCE_SCORE=6.3
# 仅语义向量（EMBED_PROVIDER=openai_compat）生效：余弦低于该值不兜底
MIN_VECTOR_SCORE=0.75
CHAT_RATE_PER_MIN=30
# /api/feedback 的独立限流（次/分钟/IP）：无鉴权公开写口，配额比 chat 严，两个桶互不占用
# FEEDBACK_RATE_PER_MIN=10
ANSWER_CACHE_SIZE=200
# 未覆盖问题留存条数（只记 noHit 的提问，供运营补资料；0 = 关闭）
UNCOVERED_LOG_SIZE=50
# 闸门未通过时是否仍调用大模型生成拒答（默认 false：固定回复，省一次调用）
# NO_HIT_LLM=true
# true 时监听 knowledge/ 热更新（Windows 上不稳定；生产请用手动 reload）
KNOWLEDGE_WATCH=false

# ── Prompt（讲解话术外置）────────────────────────────────────────
# 默认用打包内置文本（server/src/main/resources/prompts/*.txt）。现场要改措辞时：
# 把对应文本另存为一个 UTF-8 文件，在下面填它的路径覆盖内置文本，然后 POST /api/knowledge/reload 生效。
# 三个文件互相独立，只配需要改的那项即可；文件缺失/空白/读失败会记日志并回退内置文本，问答不会中断。
# PROMPT_SYSTEM_PATH=E:/znwd-config/prompt-system.txt        # system prompt（【企业知识】之前的讲解员设定）
# PROMPT_NO_HIT_HINT_PATH=                                   # 闸门未通过、仍调模型时的「直说没有」指令
# PROMPT_NO_HIT_REPLY_PATH=                                  # 闸门未通过时的固定拒答话术（不调模型）

# ── 日志 ─────────────────────────────────────────────────────────
# JSONL 日志字节上限与消息脱敏模式：hash（默认，只落 hash + 20 字前缀）| preview（落 80 字预览）
LOG_MAX_BYTES=5000000
LOG_MESSAGE_MODE=hash
