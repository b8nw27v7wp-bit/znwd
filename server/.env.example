# 本文件是模板：复制成 server/.env 再按需改（.env 不入库）。
# 读取顺序：系统环境变量 > server/.env > application.yml 默认值（见 config/DotEnvPropertySource.java）。
# 注意：所有键名以 server/src/main/resources/application.yml 为准。

# ── 大模型（回答生成）─────────────────────────────────────────────
# mock = 不联网的固定摘要（CI/离线演示）；openai_compat = 任何 OpenAI 兼容网关
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 小米 MiMo 示例（OpenAI 兼容，文档 mimo.mi.com/docs/zh-CN/api/chat/openai-api）：
#   LLM_PROVIDER=openai_compat
#   LLM_BASE_URL=https://api.xiaomimimo.com/v1
#   LLM_MODEL=mimo-v2.5          # 可选 mimo-v2.5-pro（更贵）
#   LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}   # 必填：MiMo 的 thinking 默认 enabled，开着又慢又贵
#   LLM_MAX_TOKENS=800           # 成本闸门：输出 token 上限（对应 max_completion_tokens；0 = 不限制）
# 任何 OpenAI 兼容网关都能接：填 BASE_URL/API_KEY/MODEL 即可，不必为本项目改代码。
# 免费档常有 429/1305 过载：客户端默认重试 2 次（退避 1s/2s，尊重 retry-after）
# LLM_MAX_RETRIES=2
# LLM_RETRY_BASE_MS=1000
# 单次调用总预算（含重试）；非流式默认 90000，流式默认 180000
# LLM_TIMEOUT_MS=90000
# LLM_STREAM_TIMEOUT_MS=180000

# ── Embedding（Hybrid RAG 的向量路）──────────────────────────────
# bag = 离线特征哈希兜底（semantic=false，此时检索一律按 keyword 上报，不冒充 hybrid）；
# openai_compat = 任何 OpenAI 兼容 /embeddings（云端或内网网关，semantic=true）
# 本项目现用云端（免费、无需在展板机器上再跑一个模型服务）：
#   EMBED_PROVIDER=openai_compat
#   EMBED_BASE_URL=https://api.siliconflow.cn/v1
#   EMBED_MODEL=BAAI/bge-m3      # 1024 维，中文强，定价页标「免费」；免费档有限流（约 1000 RPM / 5~8 万 TPM）
# 换 provider 后必须重建索引（POST /api/knowledge/reload 或重启），索引按 provider 分文件存放。
# 语义路走外网后：embedding 不通时服务不启动失败，而是退化为仅关键词并在 /api/health 上报
# （embeddingReady=false + retrieval.vector.degradedReason），关键词路本来就独立可用。
EMBED_PROVIDER=bag
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
# EMBED_DIMS=1024              # bge-m3 = 1024；0 = 由首次响应推断
# EMBED_BAG_DIMS=512
# EMBED_TIMEOUT_MS=60000
# EMBED_BATCH_SIZE=32          # 单请求条数上限：各家不同（阿里云百炼 10、硅基流动 32），超一条整个请求 400

# ── MySQL（会话/统计/反馈/未覆盖问题落库；不配也能讲解，只是重启丢数据）──
# 首次部署：先把 server/db/init.sql 里两处 CHANGE_ME_znwd 改成自定口令，用管理员账号执行一次；
# 建表由应用在库可达时幂等执行 schema.sql，不需要手工建表。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=znwd
DB_USER=znwd
DB_PASSWORD=            # 与 init.sql 里设置的口令一致
# DB_POOL_SIZE=8        # Hikari 连接池上限

# ── HTTP 服务 ────────────────────────────────────────────────────
# 默认仅监听本机；展厅内网跨机访问请显式改 0.0.0.0 并限制防火墙，或经反向代理暴露
HOST=127.0.0.1
PORT=8787
# 管理口令：配置后 /api/stats、/api/knowledge/reload、/api/admin/* 需带 Authorization: Bearer <token>
# ADMIN_TOKEN=
# 生产/预发强制管理口令：NODE_ENV=production|prod|staging，或下面显式开启
# REQUIRE_ADMIN_TOKEN=true
# NODE_ENV=production
# CORS 白名单（逗号分隔，可含 *）。不配置时只放行 localhost/127.0.0.1；生产须显式配置
# CORS_ORIGINS=https://exhibit.your-host.example,http://10.0.0.12:8080

# 限流键是否取 X-Forwarded-For（默认 false）。那个头客户端可写：打开前必须确认
# 前面挂着自家反代且反代会剥离同名头，否则限流可被「每次换一个头」绕过。
# TRUST_FORWARDED_FOR=false

# ── 检索与知识库 ─────────────────────────────────────────────────
KNOWLEDGE_DIR=./knowledge
INDEX_DIR=./server/indexes
DATA_DIR=./server/data
# 相关性闸门：关键词分低于该值（且语义向量路也不达标）时回答「资料中没有」，不拿无关片段硬答。
# 当前 6.3 是在 194 块语料（三份申报/概述材料）上按真实问句口径取的：区间不成立（在域最低 5.13 < 域外最高 6.27），
# 6.3 是「域外零漏放」前提下的最优覆盖点（101 条真实问句里仍拒 2 条）。取舍依据见 docs/eval.md 的阈值取舍表。
# 改语料或改同义词后必须重新标定：cd server && ../tools/mvn -B test-compile exec:java@calibrate
# 改完要同步四处：这里、application.yml 的默认值、HybridRetriever.DEFAULT_MIN_KEYWORD_SCORE、CI workflow。
MIN_RELEVANCE_SCORE=6.3
# 仅语义向量（EMBED_PROVIDER=openai_compat）生效：余弦低于该值不兜底
MIN_VECTOR_SCORE=0.35
CHAT_RATE_PER_MIN=30
ANSWER_CACHE_SIZE=200
# 未覆盖问题留存条数（只记 noHit 的提问，供运营补资料；0 = 关闭）
UNCOVERED_LOG_SIZE=50
# 闸门未通过时是否仍调用大模型生成拒答（默认 false：固定回复，省一次调用）
# NO_HIT_LLM=true
# true 时监听 knowledge/ 热更新（Windows 上不稳定；生产请用手动 reload）
KNOWLEDGE_WATCH=false

# ── 日志 ─────────────────────────────────────────────────────────
# JSONL 日志字节上限与消息脱敏模式：hash（默认，只落 hash + 20 字前缀）| preview（落 80 字预览）
LOG_MAX_BYTES=5000000
LOG_MESSAGE_MODE=hash
