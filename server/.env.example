# LLM: mock | openai_compat
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Embedding（Hybrid RAG 向量路）
# bag = 离线特征哈希兜底；openai_compat = 内网 embeddings 接口（推荐）
EMBED_PROVIDER=bag
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
# EMBED_DIMS=
# EMBED_BAG_DIMS=512

KNOWLEDGE_DIR=./knowledge
INDEX_DIR=./server/indexes
DATA_DIR=./server/data
PORT=8787
HOST=0.0.0.0
CHAT_RATE_PER_MIN=30
# 配置后 stats/reload 需 Authorization: Bearer <token>
# ADMIN_TOKEN=
ANSWER_CACHE_SIZE=200
# true 时监听 knowledge/ 热更新
KNOWLEDGE_WATCH=false
